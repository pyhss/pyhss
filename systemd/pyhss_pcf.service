# Optional 5G PCF (Npcf services over HTTP/2), e.g. for the AMF/SMF of Open5GS in 5G SA, without MongoDB.
[Unit]
Description=PyHSS 5G PCF Service
PartOf=pyhss.service
Requires=pyhss_hss.service
After=pyhss_hss.service

[Service]
Environment="PYTHONUNBUFFERED=1"
Environment="PYHSS_LOG_STDOUT_NO_TIMESTAMP=1"
User=root
WorkingDirectory=/etc/pyhss/services/
ExecStart=python3 pcfService.py
Restart=always

[Install]
WantedBy=pyhss.service
